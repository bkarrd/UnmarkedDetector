    <string name="onboarding_overlay_permission">Otworz ustawienia overlay</string>
    <string name="onboarding_overlay_settings_hint">Overlay wymaga ekranu systemowego. Za chwile otworzymy odpowiednie ustawienia.</string>
    <string name="onboarding_battery_banner_title">Wylacz agresywne oszczedzanie baterii</string>
    <string name="onboarding_battery_banner_body">Jesli system ograniczy prace aplikacji w tle, skanowanie moze zatrzymac sie podczas jazdy. To dotyczy nie tylko Xiaomi i Huawei - warto sprawdzic to na kazdym telefonie.</string>
    <string name="onboarding_mount_title">Montaz i bateria</string>
    <string name="onboarding_mount_desc">Zamontuj telefon stabilnie przy szybie tak, by tylna kamera widziala droge. Na dluzsze trasy podlacz ladowarke.</string>
    <string name="onboarding_battery_settings">Pokaz ustawienia baterii</string>
    <string name="onboarding_mode_title">Wybierz tryb pracy</string>
    <string name="onboarding_mode_subtitle">W MVP aktywny jest tylko tryb telefonu. Viofo zostaje czytelnie pokazane jako nastepny krok produktu.</string>
    <string name="onboarding_phone_mode">Tylko kamera przednia (telefon)</string>
    <string name="onboarding_phone_mode_desc">Kamera telefonu skierowana na droge. OCR co okolo 1 s, alert w tle i overlay nad nawigacja.</string>
    <string name="onboarding_viofo_mode">Kamera przednia + tylna Viofo</string>
    <string name="onboarding_viofo_mode_desc">Telefon z przodu, Viofo przez Wi-Fi z tylu. Podwojne pokrycie i wiekszy zasieg wykrywania.</string>
    <string name="onboarding_viofo_rear_mode">Tylko kamera tylna Viofo</string>
    <string name="onboarding_viofo_rear_mode_desc">Telefon jako sterownik i alert center, obraz tylko z Viofo snapshot HTTP.</string>
